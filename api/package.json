{
  "name": "@sitebot/api",
  "private": true,
  "version": "0.1.0",
  "description": "The Hono Worker: webhook routes, RAG pipeline, tenant registry, Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply sitebot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sitebot-db --remote",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@sitebot/shared": "workspace:*",
    "hono": "^4.13.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
